# Frontend runs from the repository root; Vite exposes only VITE_ variables.
VITE_API_URL=http://localhost:8000/api

# Copy into backend/.env (do not commit credentials).
DATABASE_URL=postgresql+psycopg://imperial_pack:replace-me@localhost:5432/imperial_pack
INTELLIGENCE_MODEL_DIR=./model_artifacts
SECRET_KEY=replace-with-a-random-secret-of-at-least-32-bytes
ACCESS_TOKEN_MINUTES=15
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
GOOGLE_AUTHORIZED_EMAILS=
FRONTEND_ORIGINS=http://localhost:5173
INITIAL_ADMIN_EMAIL=
COOKIE_SAMESITE=lax
COOKIE_SECURE=false
